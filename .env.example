# Tested Playground defaults. Copy to .env and fill only the auth keys.
# Source before pe-harness / uvicorn:  set -a && source .env && set +a
# The harness does not auto-load .env. YAML keys that are present (even "") override these.

# --- model: Tinker SamplingClient (ckpt 0077) ---
PE_LLM_BACKEND=tinker
PE_TINKER_SAMPLER_PATH=tinker://07ea1f18-88c1-503c-a88b-b3923034710a:train:0/sampler_weights/0077
PE_TINKER_BASE_MODEL=Qwen/Qwen3.6-35B-A3B
PE_TINKER_RENDERER=qwen3_5
TINKER_API_KEY=
PE_TINKER_API_KEY=

# unused when PE_LLM_BACKEND=tinker
PE_LLM_BASE_URL=
PE_LLM_MODEL=
PE_LLM_API_KEY=EMPTY

# --- FHIR: AWS HealthLake ---
PE_FHIR_BACKEND=aws
PE_FHIR_BASE_URL=https://healthlake.us-east-1.amazonaws.com/datastore/b08fb04f8766442ceb014071de0ca9bc/r4
HEALTHLAKE_URL=https://healthlake.us-east-1.amazonaws.com/datastore/b08fb04f8766442ceb014071de0ca9bc/r4
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- optional ---
PE_CONFIG=
PE_TOOLS_FILE=
PE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
